####################################################################
### Re-Link Real NIC ###
####################################################################
### If NIC numbers are goofy, you can regenerate link files
### Maybe 2 is missing NIC0, 1, 3, 4
### Maybe one node starts with NIC0 and another starts with NIC1
### This is a result of USB NIC IP Address being enabled (iDrac Settings)

mkdir link-backup
mv /usr/local/lib/systemd/network/*.link link-backup
pve-network-interface-pinning generate
reboot

####################################################################
### Determine which NIC are Ether VS iDrac ###
####################################################################
### Real NIC will have i40e for SFP 10GB

for n in $(ls /sys/class/net | grep -vE 'lo|vmbr|bond'); do
  printf "%-12s %s\n" "$n" "$(ethtool -i $n | awk '/^driver/{print $2}')"
done

####################################################################
### /etc/network/interfaces ###
####################################################################
### Defining each nic as manual, creating the bond, associating with vmbr0

auto lo
iface lo inet loopback

auto nic0
iface nic0 inet manual

auto nic1
iface nic1 inet manual

auto bond0
iface bond0 inet manual
        bond-slaves nic0 nic1
        bond-mode active-backup
        bond-miimon 100
        bond-primary nic0

auto vmbr0
iface vmbr0 inet static
        address 192.168.40.<DEVICE>/24
        gateway 192.168.40.1
        bridge-ports bond0
        bridge-stp off
        bridge-fd 0
        bridge-vlan-aware yes
        bridge-vids 2-4094

iface nic2 inet manual

iface nic3 inet manual

iface nic4 inet manual

####################################################################
### /etc/hosts ###
####################################################################
### It's important that the local IP is a FQDN

127.0.0.1 localhost.localdomain localhost
192.168.40.<DEVICE> proxrail00<DEVICE>.cluster proxrail00<DEVICE>

####################################################################
### Running the below commands to ensure things are good
####################################################################
### Commands to make sure things are good

ifup -a --syntax-check
ifreload -a
cat /proc/net/bonding/bond0
ip -br link
ping -c3 192.168.40.1
systemctl restart pveproxy
